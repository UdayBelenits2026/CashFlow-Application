{
  "name": "cashflow-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "server": "npm run server:spending",
    "server:dashboard": "json-server --watch database/dashboard.json --port 3000",
    "server:transactions": "json-server --watch database/transactions.json --port 3001",
    "server:income": "json-server --watch database/income.json --port 3002",
    "server:spending": "json-server --watch database/spending.json --port 3003",
    "server:cashflow": "json-server --watch database/cashflow.json --port 3004",
    "server:budget": "json-server --watch database/budget.json --port 3005",
    "server:goals": "json-server --watch database/goals.json --port 3006",
    "server:accounts": "json-server --watch database/accounts.json --port 3007",
    "server:reports": "json-server --watch database/reports.json --port 3008",
    "server:settings": "json-server --watch database/settings.json --port 3009",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.28",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngrx/store-devtools": "^20.1.0",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@ngrx/schematics": "^20.1.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^10.0.5",
    "jasmine-core": "~5.9.0",
    "json-server": "^1.0.0-beta.15",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
